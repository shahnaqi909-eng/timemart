style.css.luxury-video {
    background: #080808;
    padding: 90px 5%;
    text-align: center;
}

.video-content {
    max-width: 700px;
    margin: 0 auto 40px;
}

.video-label {
    color: #d4af37;
    font-size: 13px;
    letter-spacing: 4px;
    font-weight: bold;
}

.video-content h2 {
    font-size: 42px;
    margin: 12px 0;
}

.video-content p {
    color: #aaa;
    line-height: 1.7;
}

.video-container {
    position: relative;
    max-width: 1100px;
    height: 550px;
    margin: auto;
    overflow: hidden;
    border-radius: 12px;
    background: #000;
}

.video-container video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.video-overlay {
    position: absolute;
    bottom: 30px;
    left: 30px;
    text-align: left;
    text-shadow: 0 2px 10px #000;
}

.video-overlay h3 {
    font-size: 35px;
    margin: 0;
}

.video-overlay h3 span {
    color: #d4af37;
}

.video-overlay p {
    color: white;
    margin-top: 5px;
}

@media (max-width: 600px) {
    .video-container {
        height: 350px;
    }

    .video-content h2 {
        font-size: 30px;
    }
}
