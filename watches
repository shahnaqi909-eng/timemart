<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TimeMart - Premium Watches</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <nav class="navbar">
        <div class="logo">Time<span>Mart</span></div>

        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#products">Watches</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>

        <button class="cart-btn" onclick="openCart()">
            🛒 Cart <span id="cart-count">0</span>
        </button>
    </nav>
</header>

<section id="home" class="hero">
    <div class="hero-content">
        <p class="small-title">TIMELESS STYLE</p>
        <h1>Find Your<br><span>Perfect Time</span></h1>
        <p>
            Discover premium watches designed for people
            who value style, quality and precision.
        </p>

        <a href="#products" class="shop-btn">Shop Now →</a>
    </div>
</section>

<section id="products" class="products-section">

    <div class="section-title">
        <p>OUR COLLECTION</p>
        <h2>Featured Watches</h2>
    </div>

    <div class="products">

        <div class="product">
            <div class="watch-image">
                <img src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=800&q=80" alt="Classic Watch">
            </div>
            <h3>Classic Black</h3>
            <p>Premium stainless steel watch</p>
            <div class="price">Rs. 8,999</div>
            <button onclick="addToCart('Classic Black',8999)">Add to Cart</button>
        </div>

        <div class="product">
            <div class="watch-image">
                <img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?auto=format&fit=crop&w=800&q=80" alt="Luxury Watch">
            </div>
            <h3>Royal Gold</h3>
            <p>Elegant gold finish watch</p>
            <div class="price">Rs. 12,999</div>
            <button onclick="addToCart('Royal Gold',12999)">Add to Cart</button>
        </div>

        <div class="product">
            <div class="watch-image">
                <img src="https://images.unsplash.com/photo-1539874754764-5a96559165b0?auto=format&fit=crop&w=800&q=80" alt="Sport Watch">
            </div>
            <h3>Sport Pro</h3>
            <p>Modern watch for active lifestyles</p>
            <div class="price">Rs. 10,999</div>
            <button onclick="addToCart('Sport Pro',10999)">Add to Cart</button>
        </div>

        <div class="product">
            <div class="watch-image">
                <img src="https://images.unsplash.com/photo-1508057198894-247b23fe5ade?auto=format&fit=crop&w=800&q=80" alt="Silver Watch">
            </div>
            <h3>Silver Elite</h3>
            <p>Minimal silver design</p>
            <div class="price">Rs. 9,499</div>
            <button onclick="addToCart('Silver Elite',9499)">Add to Cart</button>
        </div>

    </div>
</section>

<section id="about" class="about">
    <div>
        <p class="small-title">ABOUT TIMEMART</p>
        <h2>Time is your greatest luxury.</h2>
        <p>
            At TimeMart, we believe a watch is more than just a
            timepiece. It's a statement of personality, confidence
            and style.
        </p>
    </div>
</section>

<section id="contact" class="contact">
    <h2>Have Questions?</h2>
    <p>Contact TimeMart and we'll be happy to help.</p>

    <a href="https://wa.me/923000000000" class="whatsapp">
        💬 Order / Contact on WhatsApp
    </a>
</section>

<footer>
    <div class="logo">Time<span>Mart</span></div>
    <p>© 2026 TimeMart. All Rights Reserved.</p>
</footer>

<!-- CART -->

<div id="cart-modal" class="cart-modal">

    <div class="cart-box">

        <button class="close" onclick="closeCart()">×</button>

        <h2>Your Cart</h2>

        <div id="cart-items"></div>

        <div class="cart-total">
            Total: Rs. <span id="cart-total">0</span>
        </div>

        <button class="checkout" onclick="checkout()">
            Checkout
        </button>

    </div>

</div>

<script src="script.js"></script>

</body>
</html>
























































































































































































































